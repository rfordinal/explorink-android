<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE scan. neverForLocation: this app never derives location from BLE
         results, it only looks for one device name, so scanning must not drag
         in a location requirement of its own. GPS location is requested
         separately below, for the actual fixes. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Real GPS fixes. These two alone carry the rider-opened-the-app path: a
         foreground service started while the app is visible and declaring the
         `location` type counts as in-use, which is enough to keep getting fixes
         with the screen locked. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Needed only for the wake path, and load-bearing there: a service the OS
         starts while the app is invisible does not hold while-in-use location, so
         without this the woken bridge connects to the X4 and has no fixes to send.
         Asked for separately, after the foreground grants, and the app still works
         without it (docs/ble-app-wake.md). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- The bridge keeps sending with the screen off, so it is a foreground
         service: it reads location and it talks to a connected BLE device. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Partial wake lock only: keeps the 5 s send timer firing in Doze. The
         screen is never held on. -->
    <!-- Tiles come from the public CDN over HTTPS (TileSource / CdnTileSource).
         One other host, and only one: a Google Maps share hands over a
         `maps.app.goo.gl` short link with no coordinates in it, so expanding it
         is the only way that flow can finish (MapsShortLink). One HEAD request,
         the Location header read and the redirect not followed, and only when
         the rider has just shared a link, never in the background. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only to show the service's own status line. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The wake: the OS watches for the associated X4 and binds
         X4PresenceService when it starts advertising. All three are normal
         permissions, granted at install, no dialog. The third one is the
         documented exemption from the rule that a background app may not start a
         foreground service. Without it the wake lands and is then refused. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <!-- Package visibility, and it is load-bearing rather than cosmetic. Since
         Android 11 an app sees only what it declares, so without this
         `resolveActivity()` on a geo: URI answers null even with Google Maps
         installed, and the map-picker button refuses itself. Measured on a
         Galaxy S24 Ultra 2026-09-02: the button did nothing and said nothing.
         Declaring the intent, not the package, so any maps app qualifies. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- required=false: a phone with no companion device support still runs the
         app, it just cannot be woken and the rider opens it by hand. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pins window. No share filter of its own any more: shared text
             lands in ShareRouteActivity below, which forwards it here with the
             same ACTION_SEND and EXTRA_TEXT this screen already reads
             (PinsActivity.prefillFromIntent), so nothing in it changed. Still
             never a silent save: the rider picks a type and confirms. -->
        <activity
            android:name=".PinsActivity"
            android:exported="false"
            android:label="ExplorInk pins"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- The map-area window. Its share filter moved to
             ShareRouteActivity for the same reason the pins one did; it is
             started with the same action and extra it always read
             (TileQueueActivity.prefillFromIntent), and nothing is queued until
             the rider has seen the plan and confirmed it. -->
        <activity
            android:name=".TileQueueActivity"
            android:exported="false"
            android:label="ExplorInk map area"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- The one share entry, and the reason it is one.
             There used to be two, one per destination, because a shared *place*
             is either a pin or an area to cache and only the rider knows which.
             That choice is still theirs: this screen asks it, with both options
             named and explained, instead of the share sheet asking it with two
             labels. What the share sheet could never do is tell a route from a
             place, and a route is the third destination (docs/route-share-plan.md),
             so a third row would have made the sheet a list to read every time.

             exported=true is what a share filter requires. Nothing here acts on
             the shared text on its own: a route is built only after the rider
             has seen its stops and pressed Send. -->
        <activity
            android:name=".ShareRouteActivity"
            android:exported="true"
            android:label="ExplorInk"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="location|connectedDevice" />

        <!-- exported=true and that permission are both required by the platform:
             the system binds this service, and the permission is what stops
             anything else from doing so. -->
        <service
            android:name=".X4PresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
