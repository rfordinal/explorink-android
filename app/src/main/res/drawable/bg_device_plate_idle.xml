<?xml version="1.0" encoding="utf-8"?>
<!-- Device plate, "resting" / "not connected" / "never paired" states per
     Outline "Dizajn systém", "Plocha zariadenia": 1dp dashed ui_rule
     border. dashWidth/dashGap need a non-zero stroke width on the view
     itself to render as dashes rather than a solid line on some GPU
     backends, hence android:width here matching the stroke width exactly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="@color/ui_rule"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
    <corners android:radius="2dp" />
    <solid android:color="@android:color/transparent" />
</shape>
