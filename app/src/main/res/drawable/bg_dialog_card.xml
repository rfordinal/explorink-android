<?xml version="1.0" encoding="utf-8"?>
<!-- The device-plate detail dialog's own card: ui_paper fill, 2dp radius,
     same almost-square corner as every other surface in the design system.
     Paired with dialog.window.setBackgroundDrawable(TRANSPARENT) in
     MainActivity so the system's own grey/dark AlertDialog chrome never
     shows through: this drawable is the whole visible dialog. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_paper" />
    <corners android:radius="2dp" />
</shape>
