<?xml version="1.0" encoding="utf-8"?>
<!-- Lucide "wallet", firmware/explorink/freeink-sdk/libs/assets/Icons/lucide/icons/wallet.svg,
     hand-converted: one Android path per source SVG path element, because a
     source path's relative commands restart from its own implicit (0,0) and
     concatenating two "d" strings makes the second continue from the first's
     end point (that is what broke ic_layers the first time). Same 24dp box,
     2dp stroke, round caps/joins as the source. The device's own Home row uses
     this same Lucide icon (firmware src/components/icons/home_icons.h), which
     is the point: one wallet, two screens, one mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="@color/ui_ink"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1" />
    <path
        android:strokeColor="@color/ui_ink"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4" />
</vector>
