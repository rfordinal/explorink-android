<?xml version="1.0" encoding="utf-8"?>
<!-- The map-area screen. Its whole reason to exist is the ask: both existing
     paths to the card are reactive, the device only ever asks for a square it
     has already failed to draw, so nothing fills ground the rider has never
     been on. Here a place found in Google Maps at home becomes a box of tiles on
     the card before the trip (docs/send-tiles-plan.md).

     The plan step above the queue is not decoration. A city is tens of megabytes
     and twenty to forty minutes over Bluetooth, and the index's sizeBytes is
     exact rather than an average, so the exact cost can be stated before the
     rider commits to any of it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQueueState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="map areas"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Red block, same as the pins screen's: a state the rider has to
                 fix before anything here moves. The most common one by far is
                 the device not being on its Sync map tiles screen, which is the
                 only screen a long batch may run over. -->
            <TextView
                android:id="@+id/tvQueueProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="#FFB00020"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvQueueStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp"
                android:text="send an area"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- A share from a maps app lands here, and so does a pasted link or
                 a typed pair. PinCoordinates reads all of them and refuses a
                 short link rather than guessing at it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etArea"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="41.3874, 2.1686  or a shared maps link"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="3"
                    android:textSize="14sp" />

                <!-- Opens a maps app at the best guess we have, so the rider can
                     find the place by looking instead of typing numbers. It is a
                     one-way trip: verified on a Galaxy S24 Ultra 2026-09-02,
                     nothing on the phone answers ACTION_PICK for a geo: URI (0
                     handlers), and Google Maps 26.35 exposes no intent that
                     returns a coordinate. So the way back is the share sheet,
                     which this activity already accepts, and the hint below says
                     so rather than leaving the rider in another app wondering. -->
                <Button
                    android:id="@+id/btnPickOnMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Open a map to pick the place"
                    android:minWidth="0dp"
                    android:text="🗺"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPickHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="Tap the map icon, hold the spot you want, then Share it back to ExplorInk tiles."
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnUseMyPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use my position" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:text="box size"
                android:textSize="13sp" />

            <!-- 20 km is the default because the returns fall off above it:
                 measured against the live CDN, another 3 MB past 20 km buys
                 outskirts (docs/send-tiles-plan.md). -->
            <RadioGroup
                android:id="@+id/rgSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSize10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 km" />

                <RadioButton
                    android:id="@+id/rbSize20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp"
                    android:text="20 km" />

                <RadioButton
                    android:id="@+id/rbSize40"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp"
                    android:text="40 km" />
            </RadioGroup>

            <Button
                android:id="@+id/btnPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check area availability" />

            <!-- The plan, in exact numbers rather than an estimate. Nothing is
                 queued until the rider has seen this and pressed Add. -->
            <TextView
                android:id="@+id/tvPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="8dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAddZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add to the queue"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="#33888888" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="nothing queued"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="8dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llZones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvQueueEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="No areas queued."
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Four equal quarters of the width, and the default Button style spends
         most of a quarter on caps and padding: "Continue" came out wrapped as
         "CONTINU / E" on a 720 px phone. Sentence case, no default side padding
         and one line each, so a label can never break mid-word again. This
         screen is read, not shouted at, and the rest of it is sentence case
         already. Seen on a Galaxy S24 Ultra, 2026-09-03. -->
    <!-- Why Continue is greyed out, next to Continue. The state that disables it
         is stated at the top of the screen ("map areas: sending"), which is the
         wrong end of a scrolling page from the button the rider is pressing: a
         disabled button with its reason off-screen reads as a broken button.
         Reported that way on 2026-09-03. -->
    <TextView
        android:id="@+id/tvQueueWhy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnQueueContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:text="Continue" />

        <Button
            android:id="@+id/btnQueuePause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:text="Pause" />

        <Button
            android:id="@+id/btnQueueClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:text="Clear sent" />

        <Button
            android:id="@+id/btnQueueClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:text="Close" />
    </LinearLayout>
</LinearLayout>
