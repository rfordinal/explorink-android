<?xml version="1.0" encoding="utf-8"?>
<!-- The map-area screen. Its whole reason to exist is the ask: both existing
     paths to the card are reactive, the device only ever asks for a square it
     has already failed to draw, so nothing fills ground the rider has never
     been on. Here a place found in Google Maps at home becomes a box of tiles on
     the card before the trip (docs/send-tiles-plan.md).

     The plan step above the queue is not decoration. A city is tens of megabytes
     and twenty to forty minutes over Bluetooth, and the index's sizeBytes is
     exact rather than an average, so the exact cost can be stated before the
     rider commits to any of it.

     App bar, section labels and the hairline divider follow the sub-screen
     shape Outline "Dizajn systém" specifies and About already uses
     (arrow-left, sans title, no subtitle; SectionLabel caption style; one
     1dp ui_rule hairline). This was the pre-redesign screen About's own
     header comment named explicitly when it adopted that shape first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnQueueBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Map areas"
            android:textColor="@color/ui_ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- What the queue is doing right now, per Outline "Dizajn
                 systém" state coding ("Rozsvietené alebo šedé nesie, či sa to
                 deje práve teraz"): ink and a verb while a phase is actively
                 running, graphite and a count while something just waits,
                 gone when there is truly nothing to say. The app bar title
                 already says "Map areas", so this line never repeats it,
                 set in TileQueueActivity.render(). -->
            <TextView
                android:id="@+id/tvQueuePhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Red block, same as the pins screen's: a state the rider has to
                 fix before anything here moves. The most common one by far is
                 the device not being on its Sync map tiles screen, which is the
                 only screen a long batch may run over. -->
            <TextView
                android:id="@+id/tvQueueProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="@color/ui_stop"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvQueueStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingBottom="12dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                style="@style/SectionLabel"
                android:text="SEND AN AREA" />

            <!-- A share from a maps app lands here, and so does a pasted link or
                 a typed pair. PinCoordinates reads all of them and refuses a
                 short link rather than guessing at it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etArea"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="41.3874, 2.1686  or a shared maps link"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="3"
                    android:textSize="14sp" />

                <!-- Opens a maps app at the best guess we have, so the rider can
                     find the place by looking instead of typing numbers. It is a
                     one-way trip: verified on a Galaxy S24 Ultra 2026-09-02,
                     nothing on the phone answers ACTION_PICK for a geo: URI (0
                     handlers), and Google Maps 26.35 exposes no intent that
                     returns a coordinate. So the way back is the share sheet,
                     which this activity already accepts, and the hint below says
                     so rather than leaving the rider in another app wondering.
                     Text, not an emoji glyph: Outline "Dizajn systém" reserves
                     icons for the Lucide set, and no map-pick glyph exists there
                     yet. -->
                <Button
                    android:id="@+id/btnPickOnMap"
                    style="@style/AppButton.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:text="Pick on map" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPickHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/ui_ash"
                android:textSize="12sp"
                android:text="Tap Pick on map, hold the spot you want, then Share it back to ExplorInk tiles." />

            <Button
                android:id="@+id/btnUseMyPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Use my position" />

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="16dp"
                android:text="BOX SIZE" />

            <!-- 20 km is the default because the returns fall off above it:
                 measured against the live CDN, another 3 MB past 20 km buys
                 outskirts (docs/send-tiles-plan.md). Default RadioButton look
                 already follows ui_ink via the theme's colorAccent override
                 (themes.xml, AppTheme), so it is not restyled further here. -->
            <RadioGroup
                android:id="@+id/rgSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSize10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 km" />

                <RadioButton
                    android:id="@+id/rbSize20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp"
                    android:text="20 km" />

                <RadioButton
                    android:id="@+id/rbSize40"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp"
                    android:text="40 km" />
            </RadioGroup>

            <Button
                android:id="@+id/btnPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Check area availability" />

            <!-- The plan, in exact numbers rather than an estimate. Nothing is
                 queued until the rider has seen this and pressed Add. -->
            <TextView
                android:id="@+id/tvPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingTop="8dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- The commit: btnPlan above only checks cost, nothing is
                 queued until this. The one primary button on this screen. -->
            <Button
                android:id="@+id/btnAddZone"
                style="@style/AppButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Add to the queue"
                android:visibility="gone" />

            <View
                style="@style/HairlineDivider"
                android:layout_marginTop="20dp" />

            <TextView
                style="@style/SectionLabel"
                android:text="QUEUE" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="Nothing queued"
                android:textColor="@color/ui_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingBottom="8dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- One zone per row, per Outline "Dizajn systém" "Riadok zoznamu",
                 separated by the system's one hairline. -->
            <LinearLayout
                android:id="@+id/llZones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_hairline"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                android:id="@+id/tvQueueEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="@color/ui_ash"
                android:textSize="13sp"
                android:text="No areas queued." />
        </LinearLayout>
    </ScrollView>

    <!-- Four equal quarters of the width, and the default Button style spends
         most of a quarter on caps and padding: "Continue" came out wrapped as
         "CONTINU / E" on a 720 px phone. Sentence case, no default side padding
         and one line each, so a label can never break mid-word again. This
         screen is read, not shouted at, and the rest of it is sentence case
         already. Seen on a Galaxy S24 Ultra, 2026-09-03.

         Three now, not four: Close moved to the app bar's back arrow, the
         same move About made first, so this row is only the actions that
         belong to the running queue. -->
    <!-- Why Continue is greyed out, next to Continue. The state that disables it
         is stated at the top of the screen ("map areas: sending"), which is the
         wrong end of a scrolling page from the button the rider is pressing: a
         disabled button with its reason off-screen reads as a broken button.
         Reported that way on 2026-09-03. -->
    <TextView
        android:id="@+id/tvQueueWhy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnQueueContinue"
            style="@style/AppButton.Quiet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textSize="14sp"
            android:text="Continue" />

        <Button
            android:id="@+id/btnQueuePause"
            style="@style/AppButton.Quiet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textSize="14sp"
            android:text="Pause" />

        <Button
            android:id="@+id/btnQueueClear"
            style="@style/AppButton.Quiet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textSize="14sp"
            android:text="Clear sent" />
    </LinearLayout>
</LinearLayout>
