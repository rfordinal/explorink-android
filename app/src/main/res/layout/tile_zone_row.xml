<?xml version="1.0" encoding="utf-8"?>
<!-- One zone the rider asked for. The whole row is the button, the same as a pin
     row: dropping a zone is the one thing to do to it and it needs a
     confirmation anyway, so it lives in the dialog the row opens rather than as
     another tap target per row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvZoneLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvZoneDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="#FF777777"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/pbZone"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000" />
</LinearLayout>
