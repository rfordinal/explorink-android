<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="starting" />

            <TextView
                android:id="@+id/tvProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:textColor="#FFB00020"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:text="auto-start: -" />

            <TextView
                android:id="@+id/tvFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:text="fix: none yet" />

            <TextView
                android:id="@+id/tvCounters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:text="sent 0 / failed 0" />

            <TextView
                android:id="@+id/tvLogFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:textSize="11sp"
                android:text="log: -" />

            <!-- Map squares, in words, above the shorthand link trace: what the
                 device asked for and what came of it. Same text size as the fix and
                 counter blocks, not the grey micro font, because it is a result
                 rather than noise. -->
            <TextView
                android:id="@+id/tvTilesHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="map squares"
                android:visibility="gone" />

            <!-- Live transfer. Two bars because they answer different questions:
                 which square of the ask, and whether this square is moving at all
                 over a 7 kB/s link. Both gone when nothing is in flight. -->
            <TextView
                android:id="@+id/tvTileNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="2dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbTileBytes"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbTileSquares"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#FF555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="16dp"
                android:textColor="#FF999999"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <!-- One button, one next step: pair the device, then grant background
             location. It hides itself once auto-start is fully set up. -->
        <Button
            android:id="@+id/btnWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair the device"
            android:visibility="gone" />

        <!-- Shown only while paired. Separate from btnWake rather than sharing it:
             the two do opposite things, and a button that changes meaning with
             state is how a rider unpairs by accident. -->
        <Button
            android:id="@+id/btnForget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forget the device"
            android:visibility="gone" />

        <!-- Pins: a second window. The list, its per-row actions and the coordinate
             field do not fit here without pushing the link state off the top
             (docs/android-pins.md). -->
        <Button
            android:id="@+id/btnPins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pins" />

        <!-- Map areas: the one path to the card that is not reactive. Both
             others only ever fetch a square the device already failed to draw,
             so nothing fills ground the rider has never been on
             (docs/send-tiles-plan.md). -->
        <Button
            android:id="@+id/btnMapAreas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Map areas" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start recording"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Retry scan" />

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share log" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
