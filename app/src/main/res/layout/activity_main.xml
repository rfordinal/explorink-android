<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- App bar, 56dp: icons only, no wordmark, per Outline "Komponenty":
         the hero below carries the wordmark, so the root screen's app bar
         drops its own and keeps just the two icon buttons on the right.
         ic_activity (Diagnostics) is disabled for now: that screen does not
         exist yet in this app. ic_ellipsis opens the overflow menu (Retry
         scan / Share log / Stop service, onOverflowPressed()) that replaced
         those three as standalone buttons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnDiagnostics"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Diagnostics"
            android:enabled="false"
            android:padding="13dp"
            android:src="@drawable/ic_activity"
            android:tint="@color/ui_ash" />

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More"
            android:padding="13dp"
            android:src="@drawable/ic_ellipsis"
            android:tint="@color/ui_ink" />
    </LinearLayout>

    <!-- The approved brand lockup (mountains + mark + wordmark), per Outline
         "Obrazovky" doc, "Brandova kresba": same drawing as
         docs/branding/explorink-home-header.svg (the firmware's 480x224
         device render) and web/assets/brand/mountains.svg, recolored to
         ui_ink/ui_paper and rasterized to drawable-nodpi/ic_home_hero.png.
         Not a VectorDrawable: the mountain line art is 547 separate potrace
         contours, and Android re-tessellates a vector's paths every frame,
         which ANR'd the activity on real hardware ("top resumed state loss
         timeout") the first time this was tried. A raster has no such cost.
         No android:tint: the bitmap already bakes in both ui_ink (lines) and
         ui_paper (knockout plates), and a tint would paint over that.
         Fixed 300x140dp, not wrap_content: the PNG lives in drawable-nodpi/
         at 1440x672px so it stays sharp, but nodpi skips density scaling, so
         without an explicit size the ImageView rendered it near 1:1 (huge)
         and pushed everything below it off screen. fitCenter keeps it
         proportional inside the fixed box. -->

    <ImageView
        android:layout_width="300dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home_hero"
        android:contentDescription="@string/app_name" />

    <!-- Device plate, ~72dp, per Outline "Dizajn systém": the top-most
         control on Home, the one assumption everything below it depends on.
         Replaces btnWake/btnForget/tvWake as standalone views: Outline says
         there is no separate Connect button on Home, so one tap here
         offers whatever is relevant to the current state instead.
         Background and icon tint swap in MainActivity.renderDevicePlate(). -->
    <LinearLayout
        android:id="@+id/devicePlate"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_device_plate_idle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/deviceIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bluetooth_off"
            android:tint="@color/ui_ash"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/deviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ui_ash"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="Connect a device" />

            <TextView
                android:id="@+id/deviceMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/ui_ash"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Instrument row, per Outline "Dizajn systém": two cells split by one
         1dp vertical hairline, never three. Lit when position is going
         out, grey when it is not: MainActivity.renderInstrumentRow()
         recolors both cells together from the same LinkState as the device
         plate (currentLinkState()), so the two elements never disagree
         about whether the link is up. Clickable: a tap opens the exact fix
         and send counters that used to sit permanently below as tvFix/
         tvCounters (onInstrumentRowPressed()), per the user's "skryjeme
         tiez do popupu" call, 2026-11-07. -->
    <LinearLayout
        android:id="@+id/instrumentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:letterSpacing="0.1"
                android:text="SPEED"
                android:textAllCaps="true"
                android:textColor="@color/ui_ash"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono_regular"
                    android:text="-"
                    android:textColor="@color/ui_ash"
                    android:textSize="22sp" />

                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_compass_ring"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/compassNeedle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_compass_needle"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:background="@color/ui_rule" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nextSendKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="@color/ui_ash"
                android:textSize="10sp"
                android:text="NEXT SEND" />

            <TextView
                android:id="@+id/nextSendValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="22sp"
                android:text="-" />

            <TextView
                android:id="@+id/nextSendSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Transfers, per Outline "Dizajn systém": one row per transfer, lit
         when something is moving, grey when idle (never hidden outright:
         the "IDLE / up to date" row is part of the spec, not an empty
         state to collapse away). Only the tile-fetch row exists: the
         wallet feature this section's Outline mockup also shows lives on
         an unmerged branch (feat/wallet), not in this app yet, so no
         second row is drawn rather than faking one. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:letterSpacing="0.1"
                android:text="TRANSFERS"
                android:textAllCaps="true"
                android:textColor="@color/ui_ash"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/transfersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/ui_rule" />

        <LinearLayout
            android:id="@+id/transferTilesRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/transferTilesIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_layers"
                android:tint="@color/ui_ash"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/transferTilesTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Map squares"
                android:textColor="@color/ui_ash"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/transferTilesValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Recording row, per Outline "Zvysok skladby": shown only while a
         ride is actually recording (gone otherwise, per the user's call,
         2026-11-07): same left/right alignment as the Transfers row
         above (no extra paddingStart/End of its own, just the shared
         16dp outer margin: a different inset read as a layout bug, the
         user's other call the same day). Starting a recording is not a
         Home-screen action any more: it is reachable from the device
         plate's tap dialog (onDevicePlatePressed()) or the app bar's
         ellipsis (onOverflowPressed()), never a permanent button here.
         Tapping this row stops recording only, never the whole bridge
         service. -->
    <LinearLayout
        android:id="@+id/recordingRow"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_activity"
            android:tint="@color/ui_ink"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recording"
                android:textColor="@color/ui_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recordingSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/ui_ash"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Empty, deliberately, per Outline "Zvysok skladby" ("(empty,
         deliberately)" right above bottom nav): what used to fill this
         space (tvEvents, the raw BLE event log, and tvVersion) duplicated
         content already shown on request elsewhere: the exact same
         events list is in the device plate's tap dialog
         (onDevicePlatePressed()) and the exact same version string is in
         the app bar ellipsis's dialog (onOverflowPressed()). Dropped
         rather than kept visible nowhere useful, per the user's call,
         2026-11-07. This spacer is what pins bottom nav to the bottom of
         the screen instead of letting it float under whatever content is
         currently visible above it. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pins/Map areas moved into bottom nav (navMapAreas/navPins);
         Retry/Share/Stop moved into the app bar's ellipsis only
         (onOverflowPressed()), not duplicated into a bottom-nav "More"
         too, per the user's call, 2026-11-07. Pair/forget moved to the
         device plate above (onDevicePlatePressed()). No separate Connect/
         Forget buttons on Home per the Outline device-plate rule. -->

    <!-- Bottom nav, per Outline "Komponenty": five destinations in the
         mockup (Home | Map data | Wallet | Pins | More), but the mockup is
         illustrative, not a spec for which screens exist. This app has
         exactly what it had as its old main menu: Home, Pins, and Map
         areas. No Wallet: that feature lives on an unmerged branch
         (feat/wallet), not in this app. No More tab either: Retry scan/
         Share log/Stop service live only in the app bar's ellipsis
         (onOverflowPressed()): the user's call, 2026-11-07, was that
         those belong up there, not duplicated into a second menu down
         here. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/ui_rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- paddingTop/Bottom live on each item, not the row: a 48dp min
             tap target is this project's own rule (themes.xml's
             AppButton.minHeight), and padding on the shared parent sits
             outside each item's clickable/ripple bounds, leaving these at
             ~39dp. Caught by Opus review, 2026-11-07. -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_house"
                android:tint="@color/ui_ink"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textAllCaps="true"
                android:textColor="@color/ui_ink"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMapAreas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_layers"
                android:tint="@color/ui_ash"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Map areas"
                android:textAllCaps="true"
                android:textColor="@color/ui_ash"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_map_pin"
                android:tint="@color/ui_ash"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pins"
                android:textAllCaps="true"
                android:textColor="@color/ui_ash"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
