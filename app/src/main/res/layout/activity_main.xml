<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- The approved brand lockup (mountains + mark + wordmark), per Outline
         "Obrazovky" doc, "Brandova kresba": same drawing as
         docs/branding/explorink-home-header.svg (the firmware's 480x224
         device render) and web/assets/brand/mountains.svg, recolored to
         ui_ink/ui_paper and rasterized to drawable-nodpi/ic_home_hero.png.
         Not a VectorDrawable: the mountain line art is 547 separate potrace
         contours, and Android re-tessellates a vector's paths every frame,
         which ANR'd the activity on real hardware ("top resumed state loss
         timeout") the first time this was tried. A raster has no such cost.
         No android:tint: the bitmap already bakes in both ui_ink (lines) and
         ui_paper (knockout plates), and a tint would paint over that.
         Fixed 300x140dp, not wrap_content: the PNG lives in drawable-nodpi/
         at 1440x672px so it stays sharp, but nodpi skips density scaling, so
         without an explicit size the ImageView rendered it near 1:1 (huge)
         and pushed everything below it off screen. fitCenter keeps it
         proportional inside the fixed box. -->

    <ImageView
        android:layout_width="300dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home_hero"
        android:contentDescription="@string/app_name" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textColor="@color/ui_ink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="starting" />

            <TextView
                android:id="@+id/tvProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:textColor="@color/ui_stop"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingBottom="12dp"
                android:textColor="@color/ui_ink"
                android:textSize="13sp"
                android:text="auto-start: -" />

            <TextView
                android:id="@+id/tvFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingBottom="12dp"
                android:textColor="@color/ui_ink"
                android:textSize="13sp"
                android:text="fix: none yet" />

            <TextView
                android:id="@+id/tvCounters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingBottom="12dp"
                android:textColor="@color/ui_ink"
                android:textSize="13sp"
                android:text="sent 0 / failed 0" />

            <TextView
                android:id="@+id/tvLogFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingBottom="12dp"
                android:textColor="@color/ui_ink"
                android:textSize="11sp"
                android:text="log: -" />

            <!-- Map squares, in words, above the shorthand link trace: what the
                 device asked for and what came of it. Same text size as the fix and
                 counter blocks, not the grey micro font, because it is a result
                 rather than noise. -->
            <TextView
                android:id="@+id/tvTilesHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp"
                android:textColor="@color/ui_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="map squares"
                android:visibility="gone" />

            <!-- Live transfer. Two bars because they answer different questions:
                 which square of the ask, and whether this square is moving at all
                 over a 7 kB/s link. Both gone when nothing is in flight. -->
            <TextView
                android:id="@+id/tvTileNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingTop="2dp"
                android:textColor="@color/ui_ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbTileBytes"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbTileSquares"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingBottom="12dp"
                android:textColor="@color/ui_ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:paddingTop="16dp"
                android:textColor="@color/ui_ash"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <!-- Role per the Outline "Aky druh, kedy" rule: btnRecord is primary
             (the one action Home always exists for, once set up), btnForget
             is destructive (discards the paired state), btnWake/btnPins/
             btnMapAreas/btnStop are secondary (a required setup step, plain
             navigation, or, for Stop, an action real enough to close the
             whole bridge and finish() the activity, which is more than
             "quiet" claims to be even though no stored state is lost), and
             btnRetry/btnExport are quiet (low-weight, repeatable). State-
             dependent primary swap, btnWake would arguably be primary while
             unpaired, is deferred, not pretended to be solved here. -->

        <!-- One button, one next step: pair the device, then grant background
             location. It hides itself once auto-start is fully set up. -->
        <Button
            android:id="@+id/btnWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Pair the device"
            android:visibility="gone" />

        <!-- Shown only while paired. Separate from btnWake rather than sharing it:
             the two do opposite things, and a button that changes meaning with
             state is how a rider unpairs by accident. -->
        <Button
            android:id="@+id/btnForget"
            style="@style/AppButton.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Forget the device"
            android:visibility="gone" />

        <!-- Pins: a second window. The list, its per-row actions and the coordinate
             field do not fit here without pushing the link state off the top
             (docs/android-pins.md). -->
        <Button
            android:id="@+id/btnPins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Pins" />

        <!-- Map areas: the one path to the card that is not reactive. Both
             others only ever fetch a square the device already failed to draw,
             so nothing fills ground the rider has never been on
             (docs/send-tiles-plan.md). -->
        <Button
            android:id="@+id/btnMapAreas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Map areas" />

        <Button
            android:id="@+id/btnRecord"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Start recording"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetry"
                style="@style/AppButton.Quiet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Retry scan" />

            <Button
                android:id="@+id/btnExport"
                style="@style/AppButton.Quiet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Share log" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
