<?xml version="1.0" encoding="utf-8"?>
<!-- The pins screen. Its whole reason to exist is the coordinate field: the
     device can only save a pin where the rider is standing, and this is where a
     place found on a map at home gets onto the card. Everything else here is the
     device's own answer, read back after every change : the device is
     authoritative and the phone keeps no copy (docs/android-pins.md). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPinsState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="pins" />

            <!-- Red block, same as the one window's: a state the rider has to fix
                 before anything here works. The most common one by far is the
                 device not being on the map screen, which is where pins live. -->
            <TextView
                android:id="@+id/tvPinsProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="#FFB00020"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPinsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="save a pin" />

            <Spinner
                android:id="@+id/spKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvPhoneFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="4dp"
                android:textSize="12sp"
                android:text="phone position: none yet" />

            <Button
                android:id="@+id/btnSaveHere"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save at the phone position" />

            <!-- The one thing the device cannot do at all: a place the rider is not
                 standing at. inputType text, not numberDecimal: a pasted Google
                 Maps link is the common case and it is not a number. -->
            <EditText
                android:id="@+id/etCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="48.4372, 17.0186  or a Google Maps link"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="3"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSaveAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save at those coordinates" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:textColor="#FF777777"
                android:textSize="11sp"
                android:text="Decimal degrees, a geo: link, or a full Google Maps link. A short maps.app.goo.gl link has no coordinates in it: open it first." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="on the device" />

            <TextView
                android:id="@+id/tvPinsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="#FF777777"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Rows are inflated into this, one per pin the device reported.
                 Never a row for an empty slot: the save spinner above already
                 lists every type, and ten rows saying "empty" is what the device's
                 own Pins list refuses to draw for the same reason. -->
            <LinearLayout
                android:id="@+id/llPins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Show history" />

            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="4dp"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnHistoryOlder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Older"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnPinsRefresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Refresh" />

        <Button
            android:id="@+id/btnPinsClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Close" />
    </LinearLayout>
</LinearLayout>
