<?xml version="1.0" encoding="utf-8"?>
<!-- About: app identity, what it does, the privacy disclosure Google Play
     expects somewhere reachable without digging (Settings/Account/About),
     the permission list it's grounded in, and the two public links. Reached
     from the app bar's "More" overflow in MainActivity, not a bottom-nav
     tab: the redesigned bottom nav is closed to real destinations only
     (Outline "Obrazovky", the user's call 2026-11-07), and this is the
     first screen in the app to use the sub-screen app bar shape the design
     system specifies (arrow-left, sans title, no subtitle) rather than a
     bottom Close button like the pre-redesign Pins/Map areas screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnAboutBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="About"
            android:textColor="@color/ui_ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Serif wordmark: the one place in a running sub-screen where
                 Instrument Serif is allowed, per Outline "Dizajn systém"
                 ("Jediné miesto, kde sa serif v bežiacej aplikácii objaví"
                 for empty states) and "Obrazovky" branding section, which
                 names About explicitly alongside onboarding and empty
                 states as a place the brand lockup belongs. No mountain
                 artwork here: that raster is sized for the 148dp Home hero
                 only, and reusing it at a different size is the same
                 drawable-nodpi scaling defect the Home build hit. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_serif_regular"
                android:text="ExplorInk"
                android:textColor="@color/ui_ink"
                android:textSize="26sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="A paper map with a dot that knows where you are."
                android:textColor="@color/ui_graphite"
                android:textSize="15sp"
                android:lineSpacingExtra="4sp" />

            <TextView
                android:id="@+id/tvAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:textColor="@color/ui_ash"
                android:textSize="11sp"
                tools:text="ExplorInk GPS 0.3.9 (21)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/ui_rule" />

            <TextView
                style="@style/AboutSectionLabel"
                android:text="WHAT IT DOES" />

            <TextView
                style="@style/AboutBody"
                android:text="Sends your phone's GPS position to your paired device over Bluetooth, and keeps its map tiles and saved pins up to date. The device itself has no turn-by-turn guidance; when you share a route into the app, it is computed by a public routing service." />

            <View style="@style/AboutDivider" />

            <TextView
                style="@style/AboutSectionLabel"
                android:text="PRIVACY" />

            <TextView
                style="@style/AboutBody"
                android:text="No analytics, no telemetry, no crash reports, and no account or server login anywhere in this app. Your live position goes only to your paired device over Bluetooth. Sharing a route or a multi-stop link sends those coordinates to a public routing service (brouter.de) to compute the route, and a Google Maps short link is expanded with one request to Google. The ride log stays on your phone; sharing it is always your choice, through Android's own share sheet." />

            <View style="@style/AboutDivider" />

            <TextView
                style="@style/AboutSectionLabel"
                android:text="PERMISSIONS" />

            <LinearLayout
                android:id="@+id/llAboutPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View style="@style/AboutDivider" />

            <TextView
                style="@style/AboutSectionLabel"
                android:text="OPEN SOURCE" />

            <TextView
                style="@style/AboutBody"
                android:text="Instrument Serif, Instrument Sans and IBM Plex Mono are used under the SIL Open Font License 1.1." />

            <Button
                android:id="@+id/btnAboutLicenses"
                style="@style/AppButton.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="View licenses" />

            <View style="@style/AboutDivider" />

            <Button
                android:id="@+id/btnAboutWebsite"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="explorink.com" />

            <Button
                android:id="@+id/btnAboutContact"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Email us" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="An ExplorInk product by Comsultia, s.r.o."
                android:textColor="@color/ui_ash"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
