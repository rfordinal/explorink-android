<?xml version="1.0" encoding="utf-8"?>
<!-- One wallet item. A monospace dump of what was rendered, because the numbers
     are the point: the device viewer cannot show them and a wrong grid or a wrong
     focal window is invisible otherwise. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="item" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvItemBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="" />
    </ScrollView>

    <!-- How much of this document the device has confirmed, in bytes. Gone, not
         empty, for a document nothing has been sent for. -->
    <ProgressBar
        android:id="@+id/barItemSync"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:max="1000"
        android:visibility="gone" />

    <!-- One row per machine-readable code (phase P5): tapping it opens the code
         full screen, decoded from the stored asset. -->
    <LinearLayout
        android:id="@+id/itemCodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Full resolution on demand. The 1:1 level is most of a document's bytes and is
         only read when the rider zooms all the way in, so it is deferred until asked
         for (WalletSyncQueue.fullQuality). -->
    <Button
        android:id="@+id/btnItemFull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="full resolution" />

    <!-- The per-document grey toggle. Flipping it rewrites the manifest and
         nothing else, which is brief section 40's own example of a metadata change
         that must not re-upload image data. -->
    <Button
        android:id="@+id/btnItemGrey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="grey" />

    <Button
        android:id="@+id/btnItemDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete this item" />
</LinearLayout>
