<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions. Merged into the main manifest for the debug variant
     only, so a release build has none of this.

     The self-test activity is exported because `adb shell am start` cannot launch
     a non-exported one, and the whole point of it is to be driven from adb: it
     reads image files out of the app's private directory and reports what code
     detection made of them (phase P5, `docs/android-wallet.md` section 13). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".wallet.WalletCodeSelfTestActivity"
            android:exported="true"
            android:label="Wallet code self-test" />

        <!-- Starts a real sync from adb and reports what the DEVICE confirmed
             (phase P6/P7, `docs/android-wallet.md` section 14.9). Exported for the
             same reason: `adb shell am start` cannot launch a non-exported
             activity, and this exists to be driven from a command line. Debug
             variant only, like the class itself. -->
        <activity
            android:name=".wallet.WalletSyncTestActivity"
            android:exported="true"
            android:label="Wallet sync self-test" />

        <!-- Exercises the wallet key against the REAL AndroidKeyStore and reports
             what protected it. The one part of the crypto path a laptop unit test
             cannot reach, because AndroidKeyStore is a platform provider
             (`docs/android-wallet.md` section 17). Exported for adb, debug only. -->
        <activity
            android:name=".wallet.WalletKeySelfTestActivity"
            android:exported="true"
            android:label="Wallet key self-test" />
    </application>
</manifest>
